# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kyc_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/kyc_db

# Security (generate real values for deployments)
SECRET_KEY=change-me-to-a-long-random-string
# Must be base64 of exactly 32 random bytes, e.g.:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=YEJsGCiJ9CBQyUNqdwjYHO91CfP71aK7Qh7RUh7VJ-Q=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage
UPLOAD_DIR=./uploads
ENCRYPTED_STORAGE_DIR=./encrypted

# AI Models
FACENET_MODEL_PATH=./models/facenet
BERT_MODEL_NAME=dslim/bert-base-NER
XGBOOST_MODEL_PATH=./models/xgboost_risk.json

# API Settings
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# TLS 1.3 (optional; set both to serve HTTPS)
# SSL_CERTFILE=./certs/cert.pem
# SSL_KEYFILE=./certs/key.pem

# Liveness tuning (optional)
LIVENESS_EAR_THRESHOLD=0.21
LIVENESS_MOTION_THRESHOLD=0.0015

# OCR / PDF (optional)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_USE_GPU=true
OCR_MAX_DIMENSION=1600
PDF_MAX_PAGES=5
PDF_RENDER_DPI=150

# Observability
LOG_JSON=true

# Login rate limiting.
# Leave REDIS_URL empty to use the in-process limiter (local dev / single worker).
# Set it (e.g. redis://localhost:6379/0) to share the limit across workers.
# On an outage the limiter fails open to the in-process window and stops probing
# Redis for REDIS_COOLDOWN_SECONDS.
REDIS_URL=
REDIS_CONNECT_TIMEOUT=0.25
REDIS_SOCKET_TIMEOUT=0.25
REDIS_COOLDOWN_SECONDS=30
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Performance
MAX_UPLOAD_SIZE=10485760
DEBUG=false
